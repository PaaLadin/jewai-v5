{
  "manifest_version": 3,
  "name": "JewAI Agent Bridge",
  "version": "5.0.1",
  "description": "Local bridge between LLM chat and filesystem. v5.",
  "permissions": [
    "storage",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "https://chat.qwen.ai/*",
    "https://alice.yandex.ru/*",
    "https://www.perplexity.ai/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "content_deepseek.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "provider_panel.html"
  },
  "action": {
    "default_title": "JewAI - open panel"
  }
}
